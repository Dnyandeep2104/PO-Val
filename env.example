# Copy this file to .env (same folder) and fill in your values.
#     cp env.example .env
# .env is in .gitignore. Never commit it.

# ---------------------------------------------------------------- Salesforce
SF_INSTANCE_URL=https://f5--poclab.sandbox.my.salesforce.com

# Option A (recommended): Salesforce CLI login. Refreshed automatically,
# so it never expires in the middle of the demo. See DEMO_RUNBOOK.md step 3.
SF_CLI_ALIAS=poclab

# Option B: a pasted session id (Workbench). Expires after a few hours.
# Leave empty when using Option A.
SF_ACCESS_TOKEN=

# Set to true to execute live bookings directly to Salesforce by default (without needing --live CLI flag)
SF_LIVE_MODE=true

# Production safeguard (set to true ONLY when deploying to a production Salesforce org)
SF_ALLOW_PRODUCTION=false

# The sandbox opportunity bookings hang off when the production
# opportunity from the quote does not exist in poclab (it usually doesn't).
# Copy the 18-character id from the opportunity's URL in poclab.
SF_DEMO_OPPORTUNITY_ID=

# The app updates PO number / amount on that sandbox opportunity so poclab's
# validation rules accept the booking form. Set to false to stop that.
SF_ADAPT_DEMO_OPPORTUNITY=true

# ----------------------------------------------------------------- Snowflake
# Live quote lookups. A browser window opens once for SSO when the portal
# starts. Leave SNOWFLAKE_USER empty to use my_quotes.json instead.
SNOWFLAKE_USER=
SNOWFLAKE_ACCOUNT=f5-enterprisedataecosystem
SNOWFLAKE_WAREHOUSE=EXP_SALES_WH
SNOWFLAKE_ROLE=APP_EDE_SALES_EXP_ROLE

# ---------------------------------------------------------------- Azure Blob
# Where Power Automate drops the emailed PO PDFs. Use ONE of:
#   a container SAS token with Read + List only (preferred), plus the account URL
#   the storage account connection string (Access keys page in the portal)
AZURE_STORAGE_SAS_TOKEN=
AZURE_STORAGE_ACCOUNT_URL=https://f5psalesstorlanding.blob.core.windows.net
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=purchaseorders
# Only watch this folder inside the container (matches the Power Automate flow)
AZURE_STORAGE_PREFIX=inbox/
AZURE_POLL_SECONDS=4

# -------------------------------------------------------------------- Portal
# Shown in the header and pre-filled as the approver when booking
PORTAL_APPROVER_NAME=
# Pause between the on-screen steps so people can follow them (ms).
# The real processing time is measured and shown separately.
PORTAL_STAGE_PACING_MS=450
# Optional: a folder to watch instead of / as well as Blob, e.g. a OneDrive
# folder that Power Automate saves attachments into (Standard connectors)
# PORTAL_INBOX_DIR=/Users/you/Library/CloudStorage/OneDrive-F5/PO Demo Inbox

# Set to true if Azure or Snowflake fail with SSL certificate errors on the
# corporate network (uses your Mac's keychain; needs: pip install truststore)
USE_OS_TRUSTSTORE=false
